<mvc:View xmlns:cards="sap.f.cards" xmlns:mdc="sap.ui.mdc" xmlns:smartfield="sap.ui.comp.smartfield" xmlns:odata="sap.ui.comp.odata" xmlns:filterbar="sap.ui.comp.filterbar" controllerName="assetdep.controller.View1"
    xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <content>
            <filterbar:FilterBar id="assetFilterBar" useToolbar="true" showFilterConfiguration="false">
                <filterbar:filterGroupItems>
                    <filterbar:FilterGroupItem name="CompanyCode" groupName="__BASIC" label="Company Code" mandatory="true" visibleInFilterBar="true">
                        <filterbar:control><MultiInput id="companyCodeFilter" placeholder="Company Code" showValueHelp="true" valueHelpRequest=".onValueHelpRequest" /></filterbar:control>
                    </filterbar:FilterGroupItem>
                    <filterbar:FilterGroupItem name="ledger" groupName="__BASIC" label="Ledger" mandatory="true" visibleInFilterBar="true">
                        <filterbar:control><MultiInput id="ledgerFilter" placeholder="Ledger" showValueHelp="true" valueHelpRequest=".onValueHelpRequest" /></filterbar:control>
                    </filterbar:FilterGroupItem>
                    <filterbar:FilterGroupItem name="DepreciationArea" groupName="__BASIC" label="Depreciation Area" mandatory="true" visibleInFilterBar="true">
                        <filterbar:control><MultiInput id="depreciationAreaFilter" placeholder="Depreciation Area" showValueHelp="true" valueHelpRequest=".onValueHelpRequest" /></filterbar:control>
                    </filterbar:FilterGroupItem>
                    <filterbar:FilterGroupItem name="keyDate" groupName="__BASIC" label="Key Date" mandatory="true" visibleInFilterBar="true">
                         <filterbar:control><DatePicker id="keyDateFilter" valueFormat="yyyy-MM-dd" displayFormat="medium" change=".onKeyDateChange" /></filterbar:control>
                    </filterbar:FilterGroupItem>
                    <filterbar:FilterGroupItem name="FiscalYear" groupName="__BASIC" label="Fisc. Year of Ledger" mandatory="true" visibleInFilterBar="true">
                        <filterbar:control><Input id="fiscalYearFilter" type="Number" placeholder="Fiscal Year" /></filterbar:control>
                    </filterbar:FilterGroupItem>
                    <filterbar:FilterGroupItem name="ToPeriod" groupName="__BASIC" label="To Period" mandatory="true" visibleInFilterBar="true">
                        <filterbar:control><Input id="toPeriodFilter" type="Number" placeholder="To Period" /></filterbar:control>
                    </filterbar:FilterGroupItem>
                    <filterbar:FilterGroupItem name="DepreciationVariant" groupName="__BASIC" label="Depreciation Variant" visibleInFilterBar="true">
                        <filterbar:control> 
                            <Input id="depreciationVariantFilter" value="Ordinary Depreciation" editable="false"/>
                        </filterbar:control>
                    </filterbar:FilterGroupItem>
                    <filterbar:FilterGroupItem name="DisplayCurrency" groupName="__BASIC" label="Display Currency" mandatory="true" visibleInFilterBar="true">
                        <filterbar:control>
                            <ComboBox id="displayCurrencyFilter" placeholder="Display Currency" items="{currency>/items}">
                                <core:Item key="{currency>Currency}" text="{currency>Currency}" />
                            </ComboBox>
                        </filterbar:control>
                    </filterbar:FilterGroupItem>
                    <filterbar:FilterGroupItem name="asset_id" groupName="__BASIC" label="Fixed Asset" visibleInFilterBar="true">
                        <filterbar:control><MultiInput id="assetIdFilter" placeholder="Fixed Asset" showValueHelp="true" valueHelpRequest=".onValueHelpRequest" /></filterbar:control>
                    </filterbar:FilterGroupItem>
                    <filterbar:FilterGroupItem name="AssetSubnumber" groupName="__BASIC" label="Asset Sub number" visibleInFilterBar="true">
                        <filterbar:control><MultiInput id="assetSubnumberFilter" placeholder="Asset Sub number" showValueHelp="true" valueHelpRequest=".onValueHelpRequest" /></filterbar:control>
                    </filterbar:FilterGroupItem>
                    <filterbar:FilterGroupItem name="AssetClass" groupName="__BASIC" label="Asset Class" visibleInFilterBar="true">
                        <filterbar:control><MultiInput id="assetClassFilter" placeholder="Asset Class" showValueHelp="true" valueHelpRequest=".onValueHelpRequest" /></filterbar:control>
                    </filterbar:FilterGroupItem>
                </filterbar:filterGroupItems>
            </filterbar:FilterBar>
            <Toolbar class="sapUiSmallMarginBegin sapUiSmallMarginEnd">
                <Title text="Asset Depreciation"/>
                <ToolbarSpacer/>
                <RadioButtonGroup id="reportTypeGroup" columns="3" selectedIndex="0">
                    <buttons>
                        <RadioButton text="Monthly"/>
                        <RadioButton text="Quarterly"/>
                        <RadioButton text="Yearly"/>
                    </buttons>
                </RadioButtonGroup>
            </Toolbar>
            <ScrollContainer
                horizontal="true"
                vertical="false"
                width="100%">
                <Table id="pivotTable"
                    mode="None"
                    class="sapUiSmallMargin">
                </Table>
            </ScrollContainer>
        </content>
    </Page>
</mvc:View>

